# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets/keys.

# Base URL of the backend API (used for all REST calls and to build the CSP connect-src)
NEXT_PUBLIC_BASE_URL=https://api.example.com/v1

# Base URL of the Socket.IO server used for realtime order/chat updates
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Google Maps JavaScript API key (used to render delivery routes in Order Details)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
